PREFIX cv: <http://data.europa.eu/m8g/>
PREFIX dct: <http://purl.org/dc/terms/>
PREFIX eli: <http://data.europa.eu/eli/ontology#>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>
PREFIX employment: <https://w3id.org/kr-employment/>

SELECT ?item ?source WHERE {
  employment:sickness-benefit cv:hasInputType employment:sickness-benefit-claim-form ;
                              cv:holdsRequirement employment:sickness-benefit-claim-deadline .
  VALUES ?item { employment:sickness-benefit employment:sickness-benefit-claim-form employment:sickness-benefit-claim-deadline }
  ?note foaf:primaryTopic ?item ;
        dct:source ?expression .
  ?expression eli:realizes ?source .
}
